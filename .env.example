PORT=5000
NODE_ENV=development

# PostgreSQL connection link. Format:
# postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/vizualizer

# Long random secret used to sign login tokens (at least 32 characters).
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts before the user must sign in again.
JWT_EXPIRES_IN=7d

# Image storage. "local" saves images in the folder below (inside server/).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ---------- AI image generation (fal.ai) ----------
# Your fal.ai API key (fal.ai → Dashboard → API Keys). Keep it secret: never share it or commit it to git.
FAL_KEY=
# The fal.ai model used to create the pictures. The default is the cheapest good option.
# Other choices (higher quality, higher price): fal-ai/nano-banana-2/edit, fal-ai/nano-banana-pro/edit
FAL_MODEL=fal-ai/nano-banana/edit
